generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  REVIEWER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  JUNIOR
  MID
  SENIOR
}

enum QuestionType {
  MCQ
  TEXT
  CODE
}

enum AttemptStatus {
  PENDING_PAYMENT
  READY
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  EVALUATED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ReviewDecision {
  PASS
  FAIL
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  password     String?
  googleId     String?    @unique
  role         Role       @default(CANDIDATE)
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?
  tokenVersion Int        @default(0)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  authoredAssessments Assessment[] @relation("AssessmentAuthor")
  candidateAttempts   Attempt[]    @relation("CandidateAttempts")
  reviewerAttempts    Attempt[]    @relation("ReviewerAttempts")
  reviews             Review[]
  payments            Payment[]
  auditLogs           AuditLog[]   @relation("AuditActor")

  @@index([role, status, deletedAt])
  @@index([createdAt])
}

model Assessment {
  id              String           @id @default(uuid())
  title           String
  slug            String           @unique
  description     String
  difficulty      Difficulty
  durationMinutes Int
  passingScore    Float
  feeCents        Int              @default(0)
  currency        String           @default("usd")
  status          AssessmentStatus @default(DRAFT)
  createdById     String
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  creator   User       @relation("AssessmentAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  questions Question[]
  attempts  Attempt[]

  @@index([status, deletedAt, createdAt])
  @@index([difficulty, status])
  @@index([createdById, deletedAt])
}

model Question {
  id            String       @id @default(uuid())
  assessmentId  String
  prompt        String
  type          QuestionType
  options       Json?
  correctAnswer Json?
  points        Int
  order         Int
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers    Answer[]

  @@unique([assessmentId, order])
  @@index([assessmentId, deletedAt])
}

model Attempt {
  id           String        @id @default(uuid())
  assessmentId String
  candidateId  String
  reviewerId   String?
  attemptNo    Int           @default(1)
  status       AttemptStatus
  startedAt    DateTime?
  expiresAt    DateTime?
  submittedAt  DateTime?
  evaluatedAt  DateTime?
  autoScore    Float?
  finalScore   Float?
  passed       Boolean?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  candidate  User       @relation("CandidateAttempts", fields: [candidateId], references: [id], onDelete: Restrict)
  reviewer   User?      @relation("ReviewerAttempts", fields: [reviewerId], references: [id], onDelete: SetNull)
  answers    Answer[]
  payment    Payment?
  review     Review?

  @@unique([candidateId, assessmentId, attemptNo])
  @@index([candidateId, status, createdAt])
  @@index([reviewerId, status])
  @@index([assessmentId, status])
}

model Answer {
  id            String   @id @default(uuid())
  attemptId     String
  questionId    String
  response      Json
  autoScore     Float?
  reviewerScore Float?
  feedback      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model Payment {
  id                      String        @id @default(uuid())
  attemptId               String        @unique
  userId                  String
  stripePaymentIntentId   String?       @unique
  stripeCheckoutSessionId String?       @unique
  amountCents             Int
  currency                String
  status                  PaymentStatus @default(PENDING)
  failureReason           String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
}

model Review {
  id         String         @id @default(uuid())
  attemptId  String         @unique
  reviewerId String
  feedback   String
  decision   ReviewDecision
  totalScore Float
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  attempt  Attempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  reviewer User    @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([reviewerId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}
