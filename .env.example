NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/developer_assessment?schema=public"

JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=12

FRONTEND_URL="http://localhost:3000"

# Optional Redis. App still runs if Redis is unavailable.
REDIS_URL="redis://localhost:6379"

# Google Sign-In (Google Identity Services client ID)
GOOGLE_CLIENT_ID=""

# Optional SMTP. If omitted, email calls are safely skipped.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="DevAssess <no-reply@example.com>"

# Optional Cloudinary. Required only for profile image upload.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Stripe test-mode keys. Required for payment endpoints.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_RETURN_URL="http://localhost:3000/payment/return"

# Seed accounts. Change for production.
SEED_ADMIN_NAME="Platform Admin"
SEED_ADMIN_EMAIL="admin@devassess.com"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_REVIEWER_NAME="Demo Reviewer"
SEED_REVIEWER_EMAIL="reviewer@devassess.com"
SEED_REVIEWER_PASSWORD="Reviewer123!"
SEED_CANDIDATE_NAME="Demo Candidate"
SEED_CANDIDATE_EMAIL="candidate@devassess.com"
SEED_CANDIDATE_PASSWORD="Candidate123!"
